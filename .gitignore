# Dependencies and package-manager caches
node_modules/
/.pnp
.pnp.*
/.npm/
.yarn/install-state.gz
.yarn/build-state.yml

# Next.js output and generated types
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Electron packages and downloaded/rebuilt native dependencies
/dist-electron/
/.native-deps/
# build/ contains versioned icons, entitlements, and installer resources.

# Test output and tooling caches
/coverage/
/.nyc_output/
/.cache/
.eslintcache

# Runtime data, uploaded files, and SQLite backups
/data/
/public/uploads/
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.*.bak
*.db.bak
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

# Local environment files and authentication/signing secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
.jwt-secret
/certificates/
*.pem
*.key
*.p12
*.pfx

# Logs and local deployment state
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.vercel/

# OS metadata and editor temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Keep package-lock.json, build/ resources, and platform launcher scripts tracked.
