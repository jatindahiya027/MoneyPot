{
  "name": "moneypot",
  "version": "0.2.4",
  "author": "MoneyPot",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.17 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3031",
    "lint": "eslint src electron scripts next.config.mjs --ext .js,.jsx,.mjs,.cjs",
    "electron:dev": "concurrently --kill-others-on-fail \"next dev -p 3031\" \"wait-on http://127.0.0.1:3031 && electron .\"",
    "electron:start": "node scripts/run-electron.js",
    "electron:build": "node scripts/build-host-target.js",
    "release:rebuild": "node scripts/rebuild-release.js",
    "electron:build:dir": "node scripts/build-host-target.js --dir",
    "deps:install": "node scripts/install-dependencies.js",
    "postinstall": "node scripts/remove-sharp.js",
    "dist:mac:arm64": "node scripts/build-desktop-target.js darwin-arm64",
    "dist:mac:x64": "node scripts/build-desktop-target.js darwin-x64",
    "electron:build:mac:arm64": "npm run dist:mac:arm64",
    "electron:build:mac:x64": "npm run dist:mac:x64",
    "prepare:native": "node scripts/prepare-native-deps.js",
    "prepare:standalone": "node scripts/prepare-standalone.js",
    "remove:sharp": "node scripts/remove-sharp.js",
    "ensure:native": "node scripts/ensure-native.js",
    "verify:package:size": "node scripts/verify-package-size.js",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist:win:arm64": "node scripts/build-desktop-target.js win32-arm64",
    "dist:win:x64": "node scripts/build-desktop-target.js win32-x64",
    "electron:build:win:arm64": "npm run dist:win:arm64",
    "electron:build:win:x64": "npm run dist:win:x64",
    "test:database": "node scripts/run-with-node22.js scripts/verify-database-runtime.mjs",
    "test:standalone": "node scripts/test-standalone.js",
    "test:sqlite3": "npm run test:database",
    "test:finance": "node scripts/run-with-node22.js scripts/verify-finance.mjs && node scripts/verify-no-runtime-cutoff.mjs && node scripts/run-with-node22.js scripts/verify-analysis.mjs",
    "test:trends": "node scripts/run-with-node22.js scripts/verify-month-trend.mjs",
    "test:preferences": "node scripts/run-with-node22.js scripts/verify-ollama-preferences.mjs",
    "test:features": "node scripts/run-with-node22.js scripts/verify-account-import-ollama.mjs",
    "test:offline": "node scripts/verify-offline.mjs",
    "test:security": "node scripts/verify-security-and-validation.mjs",
    "repair:categories": "node scripts/run-with-node22.js scripts/repair-category-integrity.mjs",
    "test": "npm run lint && npm run test:security && npm run test:finance && npm run test:trends && npm run test:preferences && npm run test:features && npm run test:database && npm run test:offline"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "jose": "^5.6.3",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^0.416.0",
    "mime": "^4.0.4",
    "motion": "^12.42.2",
    "next": "^15.5.18",
    "pdfjs-dist": "^4.10.38",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "concurrently": "^10.0.3",
    "electron": "42.6.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tar": "^7.5.2",
    "wait-on": "^9.0.10"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "unrs-resolver"
  ],
  "allowScripts": {
    "better-sqlite3": true,
    "unrs-resolver": true,
    "fsevents": false,
    "electron-winstaller": false
  },
  "overrides": {
    "next": {
      ".": "$next",
      "postcss": "8.5.10"
    }
  },
  "build": {
    "appId": "com.moneypot.desktop",
    "productName": "MoneyPot",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "scripts/electron-builder-hooks.js",
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "!node_modules/**/*",
      "!.next/standalone/public/uploads/**/*",
      "!**/.next/cache/**/*",
      "!**/*.map",
      "!**/.env",
      "!**/.env.*",
      "!**/node_modules/sharp/**/*",
      "!**/node_modules/@img/sharp-*/**/*",
      "!**/*.db",
      "!**/*.db-shm",
      "!**/*.db-wal",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "useZip": true,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
